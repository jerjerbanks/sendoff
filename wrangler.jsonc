{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendoff",
  "compatibility_date": "2026-11-24",
  "main": "vinext/server/fetch-handler",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendoff",
      "database_id": "863cbb95-5059-418b-90c1-965e8b3b07f3",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "JOIN_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CREATE_TRIP_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Region hint next to D1 (pages make many sequential queries), a 50 ms CPU cap,
  // and Workers Logs. All three are inherited by env.staging, and wrangler deploy
  // re-applies them, so a deploy never clears them.
  "placement": { "region": "aws:us-east-1" },
  "limits": { "cpu_ms": 50 },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true }
  },
  "logpush": false,
  // usefieldtrip.com and www.usefieldtrip.com are Custom Domains on this Worker, added
  // in the dashboard (Nov 27). They are deliberately NOT listed as "routes" here: with no
  // routes in config, wrangler deploy leaves them alone and the CI token needs no zone
  // permissions. www redirects to the bare domain (next.config.ts). workers.dev stays on
  // so old links, sessions and the CI checks keep working.
  "workers_dev": true,
  // Cloudflare Email Sending, for email sign-in codes. usefieldtrip.com is onboarded
  // (SPF, DKIM, DMARC records added). Included on Workers Paid: 3,000 emails a month.
  // Only the sign-in address may send.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["signin@usefieldtrip.com"] }],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*",
      "!/landing/*",
      "!/illustrations/*"
    ]
  },
  // Staging: its own Worker (sendoff-staging.<account>.workers.dev) and its own
  // empty D1, so test deploys and burst tests never touch real trips. Bindings
  // don't inherit between environments, so they're repeated here.
  // Build with CLOUDFLARE_ENV=staging (see npm run build:staging).
  "env": {
    "staging": {
      "name": "sendoff-staging",
      "workers_dev": true,
      "routes": [],
      // Staging sends real email too (the same domain), so the sign-in flow can be tried there.
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["signin@usefieldtrip.com"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sendoff-staging",
          "database_id": "61f28fc3-d6a5-4e3d-8617-81be04364664",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "JOIN_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
        { "name": "CREATE_TRIP_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
      ],
      // Cloudflare's published Turnstile TEST keys: the widget always passes, so the e2e
      // suite exercises the check on staging. Not secrets. Live uses real keys, set as
      // Worker secrets (TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY); without them it's off.
      "vars": {
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      }
    }
  }
}
