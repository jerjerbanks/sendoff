{
  "name": "sendoff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler d1 migrations apply sendoff --local && vite dev --host 0.0.0.0 --port 4747",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --port 4747",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply sendoff --local",
    "db:migrate": "wrangler d1 migrations apply sendoff --remote",
    "db:seed:sql": "tsx scripts/render-seed.ts",
    "db:seed:local": "tsx scripts/render-seed.ts && wrangler d1 execute sendoff --local --file=./seed/demo.sql",
    "db:seed": "tsx scripts/render-seed.ts && wrangler d1 execute sendoff --remote --file=./seed/demo.sql",
    "deploy:dry-run": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "dev:vinext": "vite dev --port 4747",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "build:staging": "CLOUDFLARE_ENV=staging NEXT_PUBLIC_FT_THEME_PREVIEW=1 vite build",
    "deploy:staging": "npm run build:staging && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate:staging": "wrangler d1 migrations apply sendoff-staging --env staging --remote",
    "db:migrate:list": "wrangler d1 migrations list sendoff --remote",
    "db:seed:staging": "tsx scripts/render-seed.ts && wrangler d1 execute sendoff-staging --env staging --remote --file=./seed/demo.sql",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@vinext/cloudflare": "^1.4.0",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.79.0",
    "next": "15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "type": "module"
}
